<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.muknan.wallhavenshuffle"
    android:versionCode="9"
    android:versionName="1.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <queries>
        <package android:name="com.spocky.projengmenu" />
    </queries>

    <application
        android:label="Wallhaven Shuffle"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network">

        <!-- Settings: Projectivy opens it as the plugin's "Configure"; also in the TV's app list. -->
        <activity android:name=".SettingsActivity" android:exported="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The wallpaper provider Projectivy finds and talks to (projectivy-plugin-wallpaper-provider API v1). -->
        <service android:name=".ShuffleService" android:exported="true"
            android:label="Wallhaven Shuffle" android:icon="@drawable/icon" android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="tv.projectivy.plugin.WALLPAPER_PROVIDER" />
            </intent-filter>
            <meta-data android:name="apiVersion" android:value="1" />
            <meta-data android:name="uuid" android:value="7987f08d-6228-4006-aa7e-ef456f06bac9" />
            <meta-data android:name="name" android:value="Wallhaven Shuffle" />
            <meta-data android:name="settingsActivity" android:value=".SettingsActivity" />
            <!-- One wallpaper at a time, kept for 30 s: at every change Projectivy asks again and gets the next. -->
            <meta-data android:name="itemsCacheDurationMillis" android:value="30000" />
            <!-- TIME_ELAPSED only. -->
            <meta-data android:name="updateMode" android:value="1" />
        </service>

        <!-- "Next wallpaper", e.g. from a remote button through Key Mapper. -->
        <receiver android:name=".NextReceiver" android:exported="true">
            <intent-filter>
                <action android:name="io.github.muknan.wallhavenshuffle.NEXT" />
            </intent-filter>
        </receiver>

        <!-- Puts the panel back to 60 Hz after a 25 fps video left it at 50 Hz (MediaTek "frame sync"); started by
             tv-daily.sh when the home screen comes back at 50 Hz. See-through, under a second, never in Recents. -->
        <activity android:name=".PanelResetActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:taskAffinity=""
            android:excludeFromRecents="true" android:noHistory="true" android:launchMode="singleInstance" />
    </application>
</manifest>
